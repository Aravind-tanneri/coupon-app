# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database & Scoping
DATABASE_URL=postgresql://user:password@localhost:5432/campus_mess?schema=public
DEFAULT_MESS_CODE=AKSHAYA

# Security & Session Secrets
SESSION_SECRET=
PAYOUT_ENCRYPTION_KEY=
SUPER_ADMIN_PASSWORD=

# Gemini AI API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email Delivery (Resend / SES / Nodemailer Bypass)
RESEND_API_KEY=
EMAIL_FROM=mess@campus.edu

# Optional SMTP Settings for Nodemailer (Leave blank for console/bypass mode)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# S3 Compatible Object Storage
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Cloudinary Storage Bypass (Alternative to S3)
CLOUD_NAME=
API_KEY=
API_SECRET=
FOLDER_NAME=coupon-app
